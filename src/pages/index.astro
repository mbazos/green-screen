---
import Layout from '../layouts/Layout.astro';
import Keyboard from '../components/Keyboard.astro';

// Default values for initial server-side render
const defaultMessages = [
  'Application Developer Single Sign On (SSO) - 2006',
  'Senior Application Developer EAS - 2008',
  'Senior Application Developer SE&I - 2011',
  'Senior Software Engineer Rental Car Services - 2013',
  'Principal Engineer Rental Car Services - 2016',
  'Distinguished Engineer Rental Car Services - 2018',
  'Senior Director Rental Car Services - 2024',
  'Mobility Search & Book Development Manager - 2025',
];

// Use default values for static build
// Client-side script will parse URL params and update these
const startDate = '2006-06-01T12:00:00';
const endDate = '2046-06-01T12:00:00';
const title = 'Retirement Countdown';
const showTitle = true;
const showKeyboard = true;
const footerText = 'Michael Bazos';
const showFooter = true;
const footerUrl = 'https://michaelbazos.com/';
const messages = defaultMessages;
const showMessages = messages.length > 0;
---

<Layout title="A Countdown Clock">
  <div
    id="app-container"
    class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden"
    data-start-date={startDate}
    data-end-date={endDate}
    data-title={title}
    data-show-keyboard={showKeyboard}
    data-messages={JSON.stringify(messages)}
    data-footer-text={footerText}
    data-footer-url={footerUrl}
  >
    <!-- Fireworks container (populated by JS when complete) -->
    <div id="fireworks-container" class="fixed inset-0 pointer-events-none z-10 hidden"></div>

    <!-- Customize button -->
    <button
      id="customize-btn"
      class="customize-btn fixed top-4 right-4 z-30 w-32 px-4 py-2 border-2 border-current transition-all flex items-center justify-center gap-2"
    >
      Customize
    </button>

    <!-- Music toggle button -->
    <button
      id="music-btn"
      class="music-btn fixed top-14 right-4 z-30 w-32 px-4 py-2 border-2 border-current transition-all flex items-center justify-center gap-2 music-playing"
      title="Toggle retro music"
    >
      <svg id="music-icon-off" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
      </svg>
      <svg id="music-icon-on" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
      <span id="music-text">Music</span>
    </button>

    <!-- Sound effects toggle button -->
    <button
      id="sfx-btn"
      class="sfx-btn fixed top-24 right-4 z-30 w-32 px-4 py-2 border-2 border-current transition-all flex items-center justify-center gap-2 sfx-enabled"
      title="Toggle keyboard sounds"
    >
      <svg id="sfx-icon-off" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
      </svg>
      <svg id="sfx-icon-on" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6v12m0 0l-3-3m3 3l3-3" />
      </svg>
      <span>Sounds</span>
    </button>

    <!-- Scanlines effect -->
    <div class="scanlines"></div>
    <div class="single-scanline"></div>

    <main class="flex flex-col items-center justify-center gap-6 md:gap-8 z-20 px-4">
      <header class={`text-center w-full ${showTitle ? '' : 'hidden'}`}>
        <h1 id="countdown-title" class="text-3xl sm:text-4xl md:text-6xl font-bold mb-2">
          {title}
        </h1>
      </header>

      <div class="flex gap-2 sm:gap-4 md:gap-8 text-center items-start">
        <div class="flex flex-col items-center">
          <span id="years" class="text-4xl sm:text-5xl md:text-7xl font-bold tabular-nums">0</span>
          <span class="text-xs sm:text-sm md:text-base mt-1 md:mt-2">years</span>
        </div>
        <div class="flex flex-col items-center justify-start">
          <span class="text-4xl sm:text-5xl md:text-7xl font-bold colon-pulse">:</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="days" class="text-4xl sm:text-5xl md:text-7xl font-bold tabular-nums">0</span>
          <span class="text-xs sm:text-sm md:text-base mt-1 md:mt-2">days</span>
        </div>
        <div class="flex flex-col items-center justify-start">
          <span class="text-4xl sm:text-5xl md:text-7xl font-bold colon-pulse">:</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="hours" class="text-4xl sm:text-5xl md:text-7xl font-bold tabular-nums">00</span>
          <span class="text-xs sm:text-sm md:text-base mt-1 md:mt-2">hours</span>
        </div>
        <div class="flex flex-col items-center justify-start">
          <span class="text-4xl sm:text-5xl md:text-7xl font-bold colon-pulse">:</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="minutes" class="text-4xl sm:text-5xl md:text-7xl font-bold tabular-nums">00</span>
          <span class="text-xs sm:text-sm md:text-base mt-1 md:mt-2">minutes</span>
        </div>
        <div class="flex flex-col items-center justify-start">
          <span class="text-4xl sm:text-5xl md:text-7xl font-bold colon-pulse">:</span>
        </div>
        <div class="flex flex-col items-center">
          <span id="seconds" class="text-4xl sm:text-5xl md:text-7xl font-bold tabular-nums">00</span>
          <span class="text-xs sm:text-sm md:text-base mt-1 md:mt-2">seconds</span>
        </div>
      </div>

      <div class="w-full max-w-2xl px-2">
        <div class="relative w-full h-10 sm:h-12 border-2 border-current">
          <div
            id="progress-bar"
            class="absolute top-0 left-0 h-full bg-current opacity-20 transition-all duration-1000"
            style="width: 0%"
          ></div>
          <div class="absolute inset-0 flex items-center px-2 sm:px-4">
            <span id="progress-text" class="text-base sm:text-xl md:text-2xl font-semibold">
              0.0% complete
            </span>
          </div>
        </div>

        <!-- Interactive keyboard -->
        <div class={`keyboard-typing-container mt-6 md:mt-8 w-full max-w-4xl mx-auto ${showKeyboard ? '' : 'hidden'}`}>
          <Keyboard />
        </div>

        <div class={`mt-6 sm:mt-8 h-[3.5rem] sm:h-[4rem] md:h-[4.5rem] px-2 flex items-center justify-center overflow-hidden ${showMessages ? '' : 'hidden'}`}>
          <p class="text-base sm:text-lg md:text-xl leading-relaxed text-left whitespace-pre-wrap"><span id="display-text"></span><span class={`typing-cursor ${!showMessages ? 'hidden' : ''}`}></span></p>
        </div>
      </div>
    </main>

    <footer class={`fixed bottom-2 sm:bottom-4 left-0 right-0 text-center z-20 px-4 ${showFooter ? '' : 'hidden'}`}>
      <a
        id="footer-link"
        href={footerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-base sm:text-lg md:text-xl hover:opacity-70 transition-opacity"
      >
        {footerText}
      </a>
    </footer>

    <!-- Customization Modal -->
    <div
      id="modal-backdrop"
      class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
    >
      <div
        id="modal-content"
        class="modal-content border-2 border-current p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto"
      >
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold">Customize Countdown</h2>
          <button id="modal-close" class="text-2xl hover:opacity-70">×</button>
        </div>

        <form id="customize-form" class="space-y-4">
          <div>
            <label class="block mb-2 text-sm font-semibold">Title</label>
            <input
              type="text"
              id="form-title"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none"
              placeholder="Retirement Countdown"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">Start Date (Month & Year)</label>
            <input
              type="month"
              id="form-start-date"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">End Date (Month & Year)</label>
            <input
              type="month"
              id="form-end-date"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">Messages (one per line)</label>
            <textarea
              id="form-messages"
              rows="8"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none resize-y"
              placeholder="Enter messages, one per line"
            ></textarea>
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">Footer Text</label>
            <input
              type="text"
              id="form-footer-text"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none"
            />
          </div>

          <div>
            <label class="block mb-2 text-sm font-semibold">Footer URL</label>
            <input
              type="url"
              id="form-footer-url"
              class="w-full p-2 border-2 border-current bg-transparent focus:outline-none"
              placeholder="https://example.com"
            />
          </div>

          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="form-show-keyboard"
              class="w-4 h-4 border-2 border-current bg-transparent focus:outline-none"
            />
            <label for="form-show-keyboard" class="text-sm font-semibold cursor-pointer">Show Keyboard</label>
          </div>

          <div class="flex gap-4 pt-4">
            <button
              type="submit"
              class="submit-btn flex-1 px-4 py-3 border-2 border-current transition-all font-semibold"
            >
              Apply Changes
            </button>
            <button
              type="button"
              id="modal-cancel"
              class="cancel-btn px-4 py-3 border-2 border-current transition-all"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { initCountdown } from '../scripts/countdown';
    import { initTypewriter } from '../scripts/typewriter';
    import { initKeyboard } from '../scripts/keyboard';
    import { initModal } from '../scripts/modal';
    import { toggleMusic, isMusicEnabled, toggleSoundEffects, isSoundEffectsEnabled, startMusic } from '../scripts/audio';
    import { parseQueryParams, applyParamsToPage } from '../scripts/params';

    // Initialize all modules
    document.addEventListener('DOMContentLoaded', () => {
      // Parse query params and apply to page
      const params = parseQueryParams();
      applyParamsToPage(params);

      // Now read the updated values from the container
      const container = document.getElementById('app-container')!;
      const startDate = container.dataset.startDate!;
      const endDate = container.dataset.endDate!;
      const title = container.dataset.title!;
      const showKeyboard = container.dataset.showKeyboard === 'true';
      const messages = JSON.parse(container.dataset.messages!);
      const footerText = container.dataset.footerText!;
      const footerUrl = container.dataset.footerUrl!;

      // Initialize countdown
      initCountdown(startDate, endDate);

      // Initialize typewriter
      initTypewriter(messages);

      // Initialize keyboard only if it should be shown
      if (showKeyboard) {
        initKeyboard();
      }

      // Initialize modal
      initModal(startDate, endDate, title, showKeyboard, messages, footerText, footerUrl);

      // Initialize music toggle
      const musicBtn = document.getElementById('music-btn')!;
      const musicIconOff = document.getElementById('music-icon-off')!;
      const musicIconOn = document.getElementById('music-icon-on')!;

      function updateMusicButton() {
        const isPlaying = isMusicEnabled();
        musicIconOff.classList.toggle('hidden', isPlaying);
        musicIconOn.classList.toggle('hidden', !isPlaying);
        musicBtn.classList.toggle('music-playing', isPlaying);
      }

      musicBtn.addEventListener('click', () => {
        toggleMusic();
        updateMusicButton();
      });

      // Initialize sound effects toggle
      const sfxBtn = document.getElementById('sfx-btn')!;
      const sfxIconOff = document.getElementById('sfx-icon-off')!;
      const sfxIconOn = document.getElementById('sfx-icon-on')!;

      function updateSfxButton() {
        const isEnabled = isSoundEffectsEnabled();
        sfxIconOff.classList.toggle('hidden', isEnabled);
        sfxIconOn.classList.toggle('hidden', !isEnabled);
        sfxBtn.classList.toggle('sfx-enabled', isEnabled);
      }

      sfxBtn.addEventListener('click', () => {
        toggleSoundEffects();
        updateSfxButton();
      });

      // Auto-start music on first user interaction (browsers block autoplay)
      const startMusicOnInteraction = () => {
        startMusic();
        updateMusicButton();
        document.removeEventListener('click', startMusicOnInteraction);
        document.removeEventListener('keydown', startMusicOnInteraction);
      };

      document.addEventListener('click', startMusicOnInteraction);
      document.addEventListener('keydown', startMusicOnInteraction);
    });
  </script>
</Layout>
